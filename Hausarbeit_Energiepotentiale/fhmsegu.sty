  \fill[fill=blue, scale=#1/5.5, line width=0.1pt] (12mm,27mm) -- (6mm,33mm) arc (135:225:{sqrt(2*6^2)*1mm}) -- cycle
  %Fläche unten links
  (21mm,6mm) arc (225:315:{sqrt(2*6^2)*1mm}) -- (16mm,23mm) arc (45:135:{sqrt(2*3^2)*1mm}) -- (7mm,20mm) -- cycle
  %Fläche oben
  (38mm,31mm) arc (225:315:{sqrt(2*3^2)*1mm}) -- (47mm,34mm) -- (33mm,48mm) arc (45:135:{sqrt(2*6^2)*1mm}) -- cycle
  %Fläche unten rechts
  (34mm,7mm) -- (48mm,21mm) arc (315:405:{sqrt(2*6^2)*1mm}) -- (28mm,13mm) -- cycle
  %zwei gleiche Flächen
  (24mm,17mm) arc (225:315:{sqrt(2*3^2)*1mm}) -- (33mm,20mm) -- (13mm,40mm) -- (7mm,34mm) -- cycle
  [xshift=7mm,yshift=7mm] (24mm,17mm) arc (225:315:{sqrt(2*3^2)*1mm}) -- (33mm,20mm) -- (13mm,40mm) -- (7mm,34mm) -- cycle;
 \end{tikzpicture}
 }

