\sisetup{
    locale = DE, % Einheiten als Bruch werden mit Slash geschrieben --> W/mK
    range-phrase = {\,-\,}, % Trennzeichen bei SIrange --> 35-45 °C
    range-units = single, % Bei SI range wird nur einmal eine Einheit platziert
    group-separator = {\,}, % Abstand bei Tausender setzen --> 1 000
    group-minimum-digits = 4, % Ab 4 Stellen wird ein Abstand gesetzt --> 1 234 567
    per-mode = symbol, % Einheiten als Bruch werden mit Slash geschrieben --> W/mK
    product-symbol = \times, % Multiplikationssymbol bei \qtyproduct --> \qtyproduct{1 x 2x 3}\,\si{meter}
    table-number-alignment = center % TAbelleneinträge werden immer zentriert nicht am Dezimalzeichen ausgerichtet
}
